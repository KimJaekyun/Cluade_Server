# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 절대 공개/커밋하지 마세요.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=game1945
DB_PASSWORD=
DB_NAME=1945game
# 로그인 토큰 서명용 긴 랜덤 문자열 (예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# AI 도우미(OpenRouter). 키는 서버에서만 사용되며 브라우저에 노출되지 않습니다. 비워 두면 도우미가 꺼집니다.
OPENROUTER_API_KEY=
# 사용할 모델 (기본값: openai/gpt-4o-mini). OpenRouter 의 모델 ID 를 넣으세요.
OPENROUTER_MODEL=openai/gpt-4o-mini
# 하루 전체 호출 상한 (비용 보호, 기본 500). IP당 10분에 15회 제한은 별도로 적용됩니다.
CHAT_DAILY_LIMIT=500
# 관리자 대시보드(/dashboard) 로그인 비밀번호. 비워 두면 대시보드가 꺼집니다. 길고 추측하기 어렵게 설정하세요.
# 쉼표로 구분해 여러 개 지정 가능 (예: ADMIN_PASSWORD=비번1,비번2). 비밀번호 자체에 쉼표는 쓸 수 없습니다.
ADMIN_PASSWORD=
